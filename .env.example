# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The full URL where this application is hosted.
# Used for email notification links and self-referential API endpoints.
# Example: https://goldenwizardsalon.com
APP_URL="MY_APP_URL"

# PORT: The port the Express server listens on locally.
# Defaults to 3000 if not set. Usually not required in deployment environments
# (Netlify, Railway, Render, etc.) which inject their own PORT automatically.
PORT=3000

# Owner Dashboard Authentication (set strong private values in deployment)
# OWNER_USERNAME / OWNER_PASSWORD are bootstrap-only: they are used for the very
# first login before the owner has claimed their account via /api/admin/setup.
# After setup, credentials are stored securely as scrypt hashes in .data-admin-auth.json
# (local) or verified against these env vars (Netlify serverless).
# NEVER prefix these with VITE_ — doing so would expose them in the browser bundle.
OWNER_USERNAME=""
OWNER_PASSWORD=""
OWNER_EMAIL=""

# SESSION_SECRET: Required for Netlify serverless deployments.
# A 32+ character random string used to sign HMAC session tokens.
# Sessions are stateless (no server-side session store needed) when this is set.
# Generate a value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER prefix this with VITE_ — it must remain server-side only.
SESSION_SECRET=""

# Optional Supabase Persistence & Storage (when connecting hosted Supabase)
# Leave these blank to use local .data-*.json file storage as a fallback.
# On Netlify, Supabase is REQUIRED because the serverless filesystem is ephemeral.
# SUPABASE_URL: Your project URL from Supabase Dashboard → Project Settings → API
# SUPABASE_ANON_KEY: The public "anon" key (safe to use server-side; subject to RLS)
# SUPABASE_SERVICE_ROLE_KEY: The secret "service_role" key — bypasses RLS.
#   NEVER expose the service_role key to the browser or prefix it with VITE_.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Turnstile — human verification for the question submission form.
# VITE_TURNSTILE_SITE_KEY: The PUBLIC site key — safe to embed in the browser bundle.
#   Get it from: Cloudflare Dashboard → Turnstile → your widget → Site Key
# TURNSTILE_SECRET_KEY_CLOUDFLARE: The SECRET key — server-side only. NEVER prefix with VITE_.
#   Get it from: Cloudflare Dashboard → Turnstile → your widget → Secret Key
# TURNSTILE_KEY_CLOUDFLARE: Alias for VITE_TURNSTILE_SITE_KEY (kept for reference).
VITE_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
TURNSTILE_KEY_CLOUDFLARE="YOUR_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY_CLOUDFLARE="YOUR_TURNSTILE_SECRET_KEY"

